<launch>
  <param name="/use_sim_time" value="false"/>
  <node pkg="mecanum_ugv_controller" type="mecanum_ugv_controller_node" name="mecanum_ugv_controller" ns="ugv_test" output="screen">
    <param name="control_rate_hz" value="100.0"/>
    <param name="command_publish_rate_hz" value="50.0"/>
    <param name="idle_cmd_rate_hz" value="5.0"/>
    <param name="status_publish_rate_hz" value="50.0"/>
    <param name="state_timeout" value="0.2"/>
    <param name="fence/x_min" value="-5.0"/>
    <param name="fence/x_max" value="5.0"/>
    <param name="fence/y_min" value="-5.0"/>
    <param name="fence/y_max" value="5.0"/>
    <param name="max_linear_speed" value="1.0"/>
    <param name="max_yaw_rate" value="1.0"/>
    <param name="reset_initial_x" type="double" value="0.8"/>
    <param name="reset_initial_y" type="double" value="0.0"/>
    <param name="reset_initial_yaw" type="double" value="0.0"/>
  </node>
  <test test-name="mecanum_ugv_public_command_reset_test" pkg="mecanum_ugv_controller" type="mecanum_ugv_public_command_reset_test" time-limit="30.0"/>
</launch>
