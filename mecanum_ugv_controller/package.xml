<?xml version="1.0"?>
<package format="2">
  <name>mecanum_ugv_controller</name>
  <version>1.1.0</version>
  <description>Reusable holonomic Mecanum chassis controller: health, Reset placement, and first-order Custom1. Not bound to a paper algorithm.</description>
  <maintainer email="lxk@example.com">lxk</maintainer>
  <license>BSD</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <build_depend version_gte="0.1.2-1~focal">libxgc2-state-machine-dev</build_depend>
  <build_export_depend version_gte="0.1.2-1~focal">libxgc2-state-machine-dev</build_export_depend>
  <exec_depend version_gte="0.1.2-1~focal">libxgc2-state-machine-dev</exec_depend>
  <build_depend version_gte="0.5.0-1~focal">libxgc2-math-dev</build_depend>
  <build_export_depend version_gte="0.5.0-1~focal">libxgc2-math-dev</build_export_depend>
  <exec_depend version_gte="0.5.0-1~focal">libxgc2-math-dev</exec_depend>
  <depend>ugv_reset_safety</depend>

  <test_depend>gtest</test_depend>
  <test_depend>rostest</test_depend>
  <export>
    <build_type>catkin</build_type>
  </export>
</package>
